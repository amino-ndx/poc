# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE PLANIFICACIÓN INDUSTRIAL
# ==============================================================================

# Selector de Base de Datos:
# 0 = SQLite local + datos sintéticos (Desarrollo / POC / Pruebas)
# 1 = PostgreSQL local + datos reales Npdstrazabilidad (Solo lectura)
USE_POSTGRES_REAL=0

# Configuración PostgreSQL Real (Npdstrazabilidad)
POSTGRES_DB=Npdstrazabilidad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=traking

# Configuración Django
SECRET_KEY=django-insecure-planificador-industrial-poc-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
